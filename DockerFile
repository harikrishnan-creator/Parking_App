# Multi-stage Dockerfile for Parking_App (Spring Boot)
# Builds the application with Maven and runs on a slim JRE image.

# Builder stage
FROM maven:3.10.1-eclipse-temurin-25 AS build
WORKDIR /Parking_App

# copy pom and download dependencies first (cache)
COPY pom.xml mvnw .
COPY .mvn .mvn
RUN mvn -B -ntp dependency:go-offline

# copy sources and build
COPY src src
RUN mvn -B -ntp -DskipTests package

# Runtime stage
FROM eclipse-temurin:25-jre-jammy
ARG JAR_FILE=target/*.jar
WORKDIR /app
COPY --from=build /workspace/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/app.jar"]
